{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "elsewhen",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "elsewhen" }],
  // Production namespace "elsewhen-kv"; local dev simulates it.
  "kv_namespaces": [{ "binding": "KV", "id": "8153e2ef249b40c4b1b2b5b7c5770272" }],
  "vars": {
    "DAILY_BUDGET_CENTS": "500",
    "KILL_SWITCH": "0",
    // Critic-driven repaints per era. Eras paint in parallel, so a repaint only delays its own era.
    "MAX_REPAINTS": "2"
  }
  // Secrets (wrangler secret put): MODEL_API_KEY, TURNSTILE_SITE_KEY, TURNSTILE_SECRET_KEY, SCENE_HMAC_KEY.
  // Locally they come from .dev.vars, generated from the root .env by scripts/dev-vars.mjs.
}
